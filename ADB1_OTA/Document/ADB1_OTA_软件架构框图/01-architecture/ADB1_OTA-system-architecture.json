  "cards": [
    {
      "dot": "cyan",
      "title": "Flash 布局",
      "items": [
        "Bootloader：0x08000000，16 KB",
        "Application：0x08004000，最大 47 KB",
        "Metadata：0x0800FC00，独立 1 KB 页"
      ]
    },
    {
      "dot": "emerald",
      "title": "校验链",
      "items": [
        "每一协议帧先过 CRC16-CCITT",
        "每个分片检查长度、偶数字节、连续偏移和边界",
        "FINISH 再检查总长度、CRC32 与 Cortex-M3 向量合法性"
      ]
    },
    {
      "dot": "amber",
      "title": "升级后反应",
      "items": [
        "PREPARE 成功：LED1/LED2 交替闪烁，500 ms 后复位",
        "Boot 等待/下载：LED1→LED2→LED3 跑马灯",
        "VERIFIED APP：三灯闪烁 5 s 后写 CONFIRMED"
      ]
    },
    {
      "dot": "rose",
      "title": "限制与恢复",
      "items": [
        "64 KB 器件采用单 APP 槽位，没有 A/B 自动回滚",
        "掉电或校验失败不会跳转不可信镜像，而是停留 Bootloader",
        "升级模组可从 BOOT_READY/ACK 的 received_bytes 状态重新发送"
      ]
    }
  ]
