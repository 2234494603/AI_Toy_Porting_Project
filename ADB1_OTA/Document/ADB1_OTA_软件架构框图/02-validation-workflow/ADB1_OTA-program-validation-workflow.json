  "cards": [
    {
      "dot": "cyan",
      "title": "第一层：协议帧",
      "items": [
        "固定帧头 0xDA28 与协议版本 0x01",
        "payload_len 不得超过协议上限，完整帧长度必须满足",
        "CRC16-CCITT 覆盖头部、命令、长度和载荷"
      ]
    },
    {
      "dot": "amber",
      "title": "第二层：Flash 分片",
      "items": [
        "每片最大 240 字节，声明长度必须与实际载荷一致",
        "offset 必须等于 received_bytes，禁止乱序或覆盖",
        "写入不得超过声明镜像大小与 47 KB APP 边界"
      ]
    },
    {
      "dot": "emerald",
      "title": "第三层：整镜像",
      "items": [
        "received_bytes 必须等于 metadata.image_size",
        "running_crc 最终异或后必须等于 metadata.image_crc32",
        "向量表必须指向合法 SRAM 栈和带 Thumb 位的 APP 复位入口"
      ]
    },
    {
      "dot": "rose",
      "title": "失败语义",
      "items": [
        "参数、长度、CRC 或 Flash 操作失败都不会提交 VERIFIED",
        "Bootloader 继续运行并周期上报 BOOT_READY",
        "单槽位方案没有旧镜像回滚；恢复方式是重新下发完整镜像"
      ]
    }
  ]
}
