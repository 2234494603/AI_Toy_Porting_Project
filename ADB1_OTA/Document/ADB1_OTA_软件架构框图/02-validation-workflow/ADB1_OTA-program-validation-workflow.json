      },
      {
        "id": "finish_checks",
        "label": "整镜像校验",
        "focus": ["finish_frame", "finish_gate", "crc_vector_gate", "commit_state", "activate_app"],
        "note": "接收总长、CRC32、MSP、ResetHandler 地址和 Thumb 位全部通过后才标记 VERIFIED。"
      }
